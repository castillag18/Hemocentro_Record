# Copie este archivo a .env y complete los valores

# --- Base de datos HUAV (red empresa) ---
# Servidor típico: 192.168.1.4 — en ese servidor use HUAV_DB_HOST=localhost
HUAV_DB_HOST="192.168.1.4"
HUAV_DB_PORT="3306"
HUAV_DB_NAME="huav"
HUAV_DB_USER="He_mo_center"
HUAV_DB_PASSWORD="cambiar-contraseña"
# BD de la app — SEPARADA de huav (NUNCA prisma db push sobre huav)
APP_DB_NAME="hemocentro_app"
DATABASE_URL="mysql://He_mo_center:cambiar-contraseña@192.168.1.4:3306/hemocentro_app"
# Consulta SQL para importar donantes: npm run import:donors:huav
HUAV_DONORS_SQL="donantes_info.sql"

# Desarrollo local con Docker: mysql://root:password@localhost:3306/hemocentro

AUTH_SECRET="generar-secreto-aleatorio"
# VM Linux (app): http://192.168.1.112:3000 — NO use la IP del MySQL (.4) para la app
NEXT_PUBLIC_APP_URL="http://192.168.1.112:3000"
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV="development"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# wame | openwa | api
WHATSAPP_MODE="openwa"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_VERIFY_TOKEN=""

# OpenWA self-hosted — https://www.open-wa.org/
WHATSAPP_OPENWA_URL="http://localhost:2785"
WHATSAPP_OPENWA_API_KEY=""
WHATSAPP_OPENWA_SESSION_ID="default"
WHATSAPP_DAILY_LIMIT="1000"
# Mínimo 16 caracteres (requerido por OpenWA). Luego: npm run openwa:register-webhook
OPENWA_WEBHOOK_SECRET="generar-secreto-webhook-16chars"
# OpenWA en Docker: usar host.docker.internal (NO localhost)
OPENWA_WEBHOOK_URL="http://host.docker.internal:3000/api/webhooks/openwa"

# Google OAuth (login + Calendar) — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://192.168.1.112:3000/api/auth/google/callback"

GOOGLE_CALENDAR_ID="primary"
# Opcional: cuenta de servicio (JSON en una línea) — comparta el calendario con el email de la SA
GOOGLE_CALENDAR_CREDENTIALS_JSON=""
# Opcional: refresh token OAuth (alternativa a conectar desde Configuración)
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CONNECTED_EMAIL=""

CRON_SECRET="generar-secreto-cron"

SEED_ADMIN_EMAIL="admin@hemocentro.local"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_ADMIN_NAME="Administrador"
